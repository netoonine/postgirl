{
  "name": "postwoman",
  "productName": "Postwoman",
  "version": "0.2.1",
  "description": "Cliente de APIs desktop, local e open source, compatível com coleções do Postman",
  "keywords": [
    "api",
    "rest",
    "http",
    "postman",
    "api-client",
    "electron",
    "grpc",
    "websocket",
    "mqtt",
    "graphql"
  ],
  "homepage": "https://github.com/netoonine/postwoman",
  "bugs": {
    "url": "https://github.com/netoonine/postwoman/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/netoonine/postwoman.git"
  },
  "license": "MIT",
  "author": "netoonine (https://github.com/netoonine)",
  "main": "out/main/index.js",
  "bin": {
    "postwoman": "bin/postwoman.js"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test test/e2e/app.test.mjs",
    "test:server": "node test/server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "node bin/postwoman.js",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@postman/tough-cookie": "^4.1.3-postman.1",
    "curl-to-postmanv2": "^1.8.7",
    "grpc-js-reflection-client": "^1.4.2",
    "mqtt": "^5.16.1",
    "openapi-to-postmanv2": "^6.4.0",
    "postman-code-generators": "^2.1.1",
    "postman-collection": "^5.3.1",
    "postman-collection-transformer": "^4.1.14",
    "postman-runtime": "^7.56.1",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.57.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "postman-code-generators@2.1.1": true,
    "protobufjs": false,
    "electron-winstaller": false,
    "fsevents": false
  },
  "build": {
    "appId": "app.postwoman.client",
    "productName": "Postwoman",
    "directories": {
      "output": "dist",
      "buildResources": "resources/brand"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "resources/brand/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/brand/icon-1024.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "resources/brand/icon-1024.png",
      "maintainer": "netoonine <207246753+netoonine@users.noreply.github.com>"
    },
    "publish": null
  }
}
