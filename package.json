{
  "name": "postgirl",
  "productName": "Postgirl",
  "version": "0.1.0",
  "description": "Cliente de APIs desktop compatível com coleções Postman",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@postman/tough-cookie": "^4.1.3-postman.1",
    "curl-to-postmanv2": "^1.8.7",
    "grpc-js-reflection-client": "^1.4.2",
    "mqtt": "^5.16.1",
    "openapi-to-postmanv2": "^6.4.0",
    "postman-code-generators": "^2.1.1",
    "postman-collection": "^5.3.1",
    "postman-collection-transformer": "^4.1.14",
    "postman-runtime": "^7.56.1",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "postman-code-generators@2.1.1": true,
    "protobufjs": false,
    "electron-winstaller": false
  },
  "build": {
    "appId": "app.postgirl.client",
    "productName": "Postgirl",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}